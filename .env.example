# sbs-stats-data configuration
# Copy this to .env and fill in your values.
# .env is gitignored and never committed.

# ─── Database ────────────────────────────────────────────────────────────────
# Optional, defaults to data/sbs.db in this repo (the file that is committed).
#SBS_DB_PATH=./data/sbs.db

# ─── Publishing ──────────────────────────────────────────────────────────────
# 1 = commit data/sbs.db and push after each run. Set it ONLY on the Pi,
# so that one machine writes the data.
PUBLISH=0

# Private key of the GitHub deploy key (write access) for this repo
PUBLISH_SSH_KEY=/home/pi/.ssh/sbs_stats_data_deploy

# Author of the data commits (optional). Keep an address that is not linked
# to a GitHub account, so the commits stay off your profile.
PUBLISH_GIT_NAME=sbs-stats-data
PUBLISH_GIT_EMAIL=sbs-stats-data@bot.invalid
